<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_http_limits" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.http.limits</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="99"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="HTTP Limits" string="HTTP Limits" name="sm_http_limits">
                    <block title="HTTP Request Size Limits" help="Configure the maximum allowed size for HTTP requests. Increase these values to fix the '413: Request Entity Too Large' error when uploading large files.">
                        <setting string="Max Content Length" help="Maximum total size of the HTTP request body (file uploads + form data)">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="http_max_content_length" string="Max Content Length" class="col-lg-4 o_light_label"/>
                                    <field name="http_max_content_length" class="col-lg-2"/>
                                    <span class="col-lg-2 mt-1 text-muted">MB</span>
                                </div>
                            </div>
                        </setting>
                        <setting string="Max Form Memory Size" help="Maximum size of form data that can be stored in memory">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="http_max_form_memory_size" string="Max Form Memory Size" class="col-lg-4 o_light_label"/>
                                    <field name="http_max_form_memory_size" class="col-lg-2"/>
                                    <span class="col-lg-2 mt-1 text-muted">MB</span>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
