<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_http_limits" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.http.limits</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="99"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="HTTP Limits" string="HTTP Limits" data-key="sm_http_limits">
                    <h2>HTTP Request Size Limits</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="http_max_content_length"/>
                                <div class="text-muted">
                                    Maximum total size of the HTTP request body (file uploads + form data)
                                </div>
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="http_max_content_length" string="Max Content Length" class="col-lg-4 o_light_label"/>
                                        <field name="http_max_content_length" class="col-lg-2"/>
                                        <span class="col-lg-2 mt-1 text-muted">MB</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="http_max_form_memory_size"/>
                                <div class="text-muted">
                                    Maximum size of form data that can be stored in memory
                                </div>
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="http_max_form_memory_size" string="Max Form Memory Size" class="col-lg-4 o_light_label"/>
                                        <field name="http_max_form_memory_size" class="col-lg-2"/>
                                        <span class="col-lg-2 mt-1 text-muted">MB</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
